# ========================================
# 纯前端开发环境配置 (使用 Mock 数据)
# ========================================

# API 基础路径
VITE_API_BASE_URL=/console/api
VITE_TENANT_API_BASE_URL=/tenant/api
VITE_SSO_LOGIN_URL=/idp/oauth2/authorize

# 标记为 Mock 环境
VITE_USE_MOCK=true

# 开发调试配置
VITE_SERVER_PROXY_BASE_URL=http://localhost:3000
VITE_SERVER_PROXY_SSO_LOGIN_URL=http://localhost:3000

# 开发工具配置
VITE_ENABLE_DEVTOOLS=true
VITE_MOCK_DELAY=500
